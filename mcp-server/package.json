{
  "name": "@actspan/mcp-server",
  "version": "1.1.0",
  "type": "module",
  "description": "Actspan local MCP server for the browser extension Bridge",
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/youxing-max/ActSpan"
  },
  "actspan": {
    "extensionVersion": "1.1.0",
    "extensionKey": ""
  },
  "bin": {
    "actspan-mcp": "./index.js",
    "actspan-install": "./install.js",
    "actspan-doctor": "./doctor.js",
    "actspan-bridge": "./bridge-cli.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node index.js",
    "test": "node --test test/catalog.mjs test/protocol-version.mjs test/bridge-lock.mjs test/identity.mjs test/usage.mjs test/security.mjs test/lifecycle.mjs test/status-tool.mjs test/omp-compat.mjs test/act-script.mjs test/act-tool.mjs test/tool-schema.mjs",
    "test:e2e": "node test/e2e.mjs",
    "test:install": "node --test test/install.mjs test/doctor.mjs",
    "test:acceptance": "node test/acceptance.mjs",
    "test:simuser": "node test/simulated-user.mjs",
    "check:docs": "node check-tool-docs.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "ws": "8.22.0",
    "zod": "3.25.76"
  }
}
